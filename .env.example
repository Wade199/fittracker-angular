# =============================================
# VARIABLES D'ENVIRONNEMENT — FitTracker
# Copie ce fichier en .env puis remplis CHAQUE valeur.
# Ne commite jamais le fichier .env.
# =============================================

# Mot de passe PostgreSQL (long et aléatoire)
#   openssl rand -base64 24
DB_PASSWORD=

# Secret de signature JWT, minimum 256 bits (le backend refuse de démarrer sinon)
#   openssl rand -base64 64
JWT_SECRET=

# Environnement
NODE_ENV=production
